{% assign foorter_logo_size = '117x36' %}
{%- assign item = section.settings -%}

<div class="footer_type_2">
		<div class="container bg-footer rounded {% if section.settings.inverted %} inverted{% endif %}" style="background-color: {{ section.settings.bg_footermain }}">
			<div class="footer_main row justify-content-between pt-md-4 pb-2">

				{% if section.settings.footer_logo %}
					<div class="col-12 col-md-4 without_toggle">
						<div class="footer_block border-n px-2">
							{% if section.settings.footer_logo_slogan.size > 0 %}
								{% assign logo_slogan = section.settings.footer_logo_slogan | prepend: '<div class="footer-logo-slogan text">' | append:'</div>' %}
							{% endif %}
							{% assign logo_type = section.settings.footer_logo_type %}
							{% assign logo_i = section.settings.footer_logo_main %}
							{% assign logo_src = section.settings.footer_logo_main | img_url: footer_logo_size, crop: 'center', scale: 2 %}
							 {% assign logo_svg = section.settings.logo_main_svg %}
                  {% include 'logo-footer' slogan: logo_slogan,logo_svg:logo_svg, logo_t: logo_type, logo_image: section.settings.footer_logo_main, src: logo_src %}
						</div>
					</div>
				{% endif %}
                <div class="col-12 col-md-8 row">
                    <div class="col-12 d-flex flex-column flex-sm-row  {% if section.settings.footer_submenu == blank %} justify-content-center {% else %} justify-content-between  {% endif %}">
                        {% if section.settings.footer_submenu_1.size > 0 %}
                            <div class="text-md-left col">
                                <h6 class="pb-2">SITEMAP</h6>
                                <ul class="footer-link-block mt-0 mx-0 mb-md-0 mb-3">
                                    {% for link in linklists[section.settings.footer_submenu_1].links %}
                                        <li class="link-block-item  pb-1">
                                            <a class="link-block-link" href="{{ link.url }}">{{ link.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        {% if section.settings.footer_submenu_2.size > 0 %}
                            <div class="text-md-left col">
                                <h6 class="pb-2">COMPANY</h6>
                                <ul class="footer-link-block mt-0 mx-0 mb-md-0 mb-3">
                                    {% for link in linklists[section.settings.footer_submenu_2].links %}
                                        <li class="link-block-item  pb-1">
                                            <a class="link-block-link" href="{{ link.url }}">{{ link.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        {% if section.settings.footer_submenu_3.size > 0 %}
                            <div class="text-md-left col">
                                <h6 class="pb-2">CONTACT</h6>
                                <ul class="footer-link-block mt-0 mx-0 mb-md-0 mb-3">
                                    {% for link in linklists[section.settings.footer_submenu_3].links %}
                                        <li class="link-block-item  pb-1">
                                            <a class="link-block-link" href="{{ link.url }}">{{ link.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
				{% for block in section.blocks %}
					{% case block.settings.column_item %}
						{% when 'column_2' %}
						{% assign column_width_class = 'col-md-2' %}
						{% when 'column_3' %}
						{% assign column_width_class = 'col-md-3' %}
						{% when 'column_4' %}
						{% assign column_width_class = 'col-md-4' %}
						{% when 'column_5' %}
						{% assign column_width_class = 'col-md-5' %}
						{% when  'column_6' %}
						{% assign column_width_class = 'col-md-6' %}
						{% when 'column_7' %}
						{% assign column_width_class = 'col-md-7' %}
					{% endcase %}
					{% case block.type %}
						{% when 'linklist' %}
							{%- assign linklist = block.settings.links -%}
							<div class="col-12 {{ column_width_class }} footer_block"  style="display: none">
								<div class="footer_item footer_item__links{% if block.settings.custom_class.size > 0 %} {{ block.settings.custom_class }}{% endif %}">
									<h6 class="linklist_footer_title toggle-mobile mb-2">
										{{ linklists[linklist].title }}
										<svg class="d-md-none" width="9" height="6" viewBox="0 0 9 6" xmlns="http://www.w3.org/2000/svg"><path d="M9 1.5L7.5 0L4.5 3L1.5 0L0 1.5L4.5 6L9 1.5Z" /></svg>
									</h6>
									<ul class="link_list content-toggle-mobile">
										{% for link in linklists[linklist].links %}
											<li>
												<a {% if link.active %}class="active"{% endif %} href="{{ link.url }}">{{ link.title }}</a>
											</li>
										{% endfor %}
									</ul>
								</div>
							</div>
						{% when 'contacts' %}
							<div class="col-12 {{ column_width_class }} footer_block">
								<div class="footer_item footer_item__contacts">
									<h6 class="linklist_footer_title toggle-mobile mb-2 d-md-none">
										{{ block.settings.contacts_title }}
										<svg class="d-md-none" width="9" height="6" viewBox="0 0 9 6" xmlns="http://www.w3.org/2000/svg"><path d="M9 1.5L7.5 0L4.5 3L1.5 0L0 1.5L4.5 6L9 1.5Z" /></svg>
									</h6>
									<div class="content-toggle-mobile">
										{% include 'widget-contact-list' %}
									</div>
								</div>
							</div>
						{% when 'newsletter' %}
							<div class="col-12 mx-auto without_toggle {{ column_width_class }} border-n footer_block">

								<div class="footer_item footer_item__newsletter">
									<div class="newsletter-info">
										{% if block.settings.newsletter_text != blank %}
											<p class="newsletter-title">
												{{ block.settings.block_title | escape }}
											</p>
										{% endif %}
										{% if block.settings.newsletter_text != blank %}
											<p class="newsletter-description">
												{{ block.settings.newsletter_text | escape }}
											</p>
										{% endif %}
									</div>
									<div class="item__newsletter">
										{% include 'widget-newsletter' %}
									</div>
								</div>
							</div>
					{% endcase %}
				{% endfor %}
			  {% if section.settings.social_menu %}
				<div class="col-12 without_toggle mt-1">
				  <div>
					{% include 'social-icon-link'  style: 'type_1' %}
				  </div>
				</div>
			  {% endif %}
			</div>
			<div class="footer_bottom_pannel pt-0 pb-3">
					<div class="row">
						<div class="col-md-6 col-12 d-flex flex-md-row flex-column  {% if section.settings.footer_submenu_1 == blank %} justify-content-center {% else %} justify-content-between  {% endif %}">
							{% if section.settings.powered_toggle %}
							  <div class="footer_copyright">
								{%- capture shop_copyright_link -%}
								  {% if section.settings.copyright_link != blank and section.settings.copyright_text != blank %}
									<a href="{{ section.settings.copyright_link }}">{{ section.settings.copyright_text }}</a>
								  {% else %}
									<a href="{{ shop.url }}">{{ shop.name }}</a>
								  {% endif %}
								{%- endcapture -%}
								
								{% assign copyright_year = "now" | date: "%Y" %}
								<div class="mt-3 px-2 text-md-left">© {{ copyright_year }} {{ shop_copyright_link }}</div>
							  </div>
							{% endif %}
						</div>
                        <div class="col-md-6 col-12">
                            {% comment %}<div class="mt-3 px-2">The statements on this website have not been evaluated by the TGA or FDA. These products are not intended to diagnose, treat, cure or prevent any disease.</div>{% endcomment %}
                            <div class="mt-3 px-2 statement_rights">{{ section.settings.policy_record | escape }}</div>
                        </div>
						{% if section.settings.payment_icons_toggle %}
							<div class="col-12 text-center mt-2 mt-md-3">
								{% include 'payment-icons' %}
							</div>
						{% endif %}
					</div>
				</div>
	  	</div>
</div>

	
{% schema %}
{
	"name": "Footer type 2",
	"tag": "footer",
	"class": "section--footer",
	"max_blocks": 4,
	"settings": [

		{
			"type": "color",
			"id": "bg_footermain",
			"label": "Background color",
			"default": "#FFFFFF"
		},

		{
			"type": "checkbox",
			"id": "inverted",
			"label": "Apply inverted color (white)",
			"default": false
		},
		// FOOTER LOGO
		{
			"type": "header",
			"content": "Footer Logo"
		},
		{
			"type": "checkbox",
			"id": "footer_logo",
			"label": "Show logo or slogan",
			"default": true
		},
		{
			"type": "radio",
			"id": "footer_logo_type",
			"label": "Logo type",
			"options": [
				{
					"value": "txt",
					"label": "Text logo"
				},
				{
					"value": "img",
					"label": "Image logo"
				}
			]
		},
		{
			"type": "header",
			"content": "Retina logo information",
			"info": "For a better display of the logo for retina display devices, load the logo twice as large as the required"
		},
		{
			"type": "image_picker",
			"id": "footer_logo_main",
			"label": "Logo image"
		},
      {
	  "type": "html",
	  "id": "logo_main_svg",
	  "label": "Logo svg"
	},
		{
			"type": "richtext",
			"id": "footer_logo_slogan",
			"label": "Logo slogan"
		},

		// COPYRIGHT
		{
		  "type": "header",
		  "content": "Copyright link"
		},
		{
		  "type": "checkbox",
		  "id": "powered_toggle",
		  "label": "Show copyright link",
		  "default": true
		},
		
		{
		  "type": "paragraph",
		  "content": "Custom copyright link"
		},
		{
		  "type": "url",
		  "id": "copyright_link",
		  "label": "Copyright link"
		},
		{
		  "type": "text",
		  "id": "copyright_text",
		  "label": "Copyright link text"
		},
        {
           "type": "text",
           "id": "policy_record",
           "label": "Policy record"
        },
		// SOCIAL ICONS
		{
			"type": "header",
			"content": "Social Menu"
		},
		{
			"type": "checkbox",
			"id": "social_menu",
			"label": "Show social menu",
			"default": true
		},
			// PAYMENT ICONS
		{
			"type": "checkbox",
			"id": "payment_icons_toggle",
			"label": "Show payment icons",
			"default": true,
			"info": "Mark the required in theme settings"
		},
		// FOOTER SUBMENU#1
		{
			"type": "header",
			"content": "Footer submenu #1"
		},
		{
			"type": "link_list",
			"id": "footer_submenu_1",
			"label": "Footer submenu #1",
			"info": "SITEMAP"
		},
        // FOOTER SUBMENU#2
        {
            "type": "header",
            "content": "Footer submenu #2"
        },
        {
            "type": "link_list",
            "id": "footer_submenu_2",
            "label": "Footer submenu #2",
            "info": "COMPANY"
        },
        // FOOTER SUBMENU#3
        {
        "type": "header",
        "content": "Footer submenu #3"
        },
        {
        "type": "link_list",
        "id": "footer_submenu_3",
        "label": "Footer submenu #3",
        "info": "CONTACT"
        }
	],
	"blocks": [
		// LINKLIST
		{
			"type": "linklist",
			"name": "Linklist",
			"settings": [
				{
					"type": "select",
					"id": "column_item",
					"label": "Column width",
					"options": [
					{
						"value": "column_2",
						"label": "width 16.6667%"
					},
					{
						"value": "column_3",
						"label": "width 25%"
					},
					{
						"value": "column_4",
						"label": "width 33.3333%"
					},
					{
						"value": "column_5",
						"label": "width 41.6667%"
					},
					{
						"value": "column_6",
						"label": "width 50%"
					}
				],
				"default": "column_3"
				},
				{
					"type": "link_list",
					"id": "links",
					"label": "Choose linklist"
				},
				{
					"type": "text",
					"id": "custom_class",
					"label": "Custom class"
				}
			]
		},
		// CONTACTS BLOCK
		{
			"type": "contacts",
			"name": "Contacts block",
			"settings": [
				{
					"type": "select",
					"id": "column_item",
					"label": "Column width",
					"options": [
						{
							"value": "column_2",
							"label": "width 16.6667%"
						},
						{
							"value": "column_3",
							"label": "width 25%"
						},
						{
							"value": "column_4",
							"label": "width 33.3333%"
						},
						{
							"value": "column_5",
							"label": "width 41.6667%"
						},
						{
							"value": "column_6",
							"label": "width 50%"
						}
					],
					"default": "column_3"
				},
				{
					"type": "text",
					"id": "contacts_title",
					"label": "Block title"
				}
			]
		},
		// Newsletter
		{
			"type": "newsletter",
			"name": "Newsletter",
			"settings": [
				{
					"type": "select",
					"id": "column_item",
					"label": "Column width",
					"options": [
						{
							"value": "column_2",
							"label": "width 16.6667%"
						},
						{
							"value": "column_3",
							"label": "width 25%"
						},
						{
							"value": "column_4",
							"label": "width 33.3333%"
						},
						{
							"value": "column_5",
							"label": "width 41.6667%"
						},
						{
							"value": "column_6",
							"label": "width 50%"
						},
						{
							"value": "column_7",
							"label": "width 66%"
						}
					],
					"default": "column_3"
				},
				{
					"type": "paragraph",
					"content": "Newsletter"
				},
				{
					"type": "text",
					"id": "block_title",
					"label": "Block title",
					"default": "Newsletter"
				},
				{
					"type": "text",
					"id": "newsletter_text",
					"label": "Newsletter text"
				}
			]
		}
	]
}
{% endschema %}

{% javascript %}
jQuery(document).ready(function($) {
	$('#newsletter_form .alert-success').hide();
	// CHECK FORM POSTED
	$('.contact-form').each(function (){
		$(this).on('submit', function(e){
			var formCookie = $(this).attr('class');
			$.cookie('formSended', formCookie);
		});
	});

	if( document.location.href.indexOf('?customer_posted=true') > 0 && $.cookie('formSended') == 'contact-form') {
		$('#newsletter_form .form-wrapper').hide();
		$('#newsletter_form .newsletter-description').hide();
		$('#newsletter_form .alert-success').show();
	};

	// FORM VALIDATION
	$('#newsletter_form').formValidation();

});
{% endjavascript %}